{
  "name": "python-speedrun",
  "private": true,
  "version": "1.0.0",
  "description": "面向零基础的 Python 教程（从第一行代码开始的 30 小时课程，主线做出命令行小工具，进阶选修直通 AI 应用开发）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "validate": "node scripts/validate-content.mjs",
    "check": "node scripts/validate-content.mjs && vite build",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "element-plus": "^2.9.7",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "qrcode-terminal": "^0.12.0",
    "vite": "^6.2.5",
    "wrangler": "^4.158.0"
  }
}
